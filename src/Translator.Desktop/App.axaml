<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Translator.Desktop.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#AB316B" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Translator.Desktop/SakuraTheme.axaml" />
  </Application.Styles>
</Application>
